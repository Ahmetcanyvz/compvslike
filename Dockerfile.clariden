FROM nvcr.io/nvidia/pytorch:24.04-py3

RUN pip install --no-cache-dir \
    "transformers>=4.48.0,<5.0.0" \
    "lightning>=2.5.0,<2.6.0" \
    "datasets>=3.0.0" \
    "polars>=1.25.0" \
    "typer>=0.15.0" \
    "tqdm>=4.66.0" \
    "statsmodels>=0.14.0" \
    "liger-kernel>=0.5.0,<0.6.0" \
    "torchdata==0.7.1"
